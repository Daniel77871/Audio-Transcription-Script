#############################################
# 必填項目
#############################################
# 你的 OpenAI API 金鑰（請勿公開）
API_KEY=

# 指定要使用的轉錄模型名稱，例如 gpt-4o-transcribe($2.5/1M tokens)、gpt-4o-mini-transcribe($1.25/1M tokens)、whisper-1
# 若不指定則預設為 gpt-4o-transcribe
TRANSCRIBE_MODEL=gpt-4o-transcribe

# 將原始音檔切割成每段幾分鐘
# 建議 1～10 之間，數值愈大 API 呼叫次數愈少，但 OpenAI 規定一次最大為 25MB
CHUNK_MINUTE=10

# 欲處理的音檔檔名（請放在本專案根目錄下的 input/ 資料夾內）
AUDIO_FILE=report.m4a

#############################################
# 選填項目
#############################################

# 是否在最終輸出檔案中，於每個句尾（。！？.？）自動插入換行分段
# true  -> 每句一行，方便閱讀／校對
# false -> 完整輸出一整段文字，方便下 prompt 給 GPT
ENABLE_SEGMENTATION=false

# （選填）轉錄時給模型的提示文字，用以提升用詞與格式一致性
# － 若無需自訂提示，可刪除此行或留空
# － 若要修改，請將整段內容放在同一行內，用 \n 代表換行
PROMPT="請將以下語音內容完整轉錄，務必符合以下要求：\n1. 全部輸出請使用繁體中文，絕對不要使用簡體中文。\n2. 保留原文中所有英文單字、片語或專有名詞，不要翻譯或替換。\n3. 確保轉錄內容完整且正確，務必包含所有標點符號（如句號、逗號、問號、驚嘆號等）。\n4. 請勿分段，所有文字以連貫自然的完整段落呈現。\n5. 對於聽不清或無法辨識的部分，請以「[不確定]」標示。"

#############################################
# 【參考用】預設 Prompt 範例（僅供複製貼上修改）
#############################################
# "請將以下語音內容完整轉錄，務必符合以下要求：\n\
# 1. 全部輸出請使用繁體中文，絕對不要使用簡體中文。\n\
# 2. 保留原文中所有英文單字、片語或專有名詞，不要翻譯或替換。\n\
# 3. 確保轉錄內容完整且正確，務必包含所有標點符號（如句號、逗號、問號、驚嘆號等）。\n\
# 4. 請勿分段，所有文字以連貫自然的完整段落呈現。\n\
# 5. 對於聽不清或無法辨識的部分，請以「[不確定]」標示。"